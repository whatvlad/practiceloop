# Cloudflare Pages response headers (#38). Pages Functions ignore this file, so
# /api responses carry the API's own headers (backend/app/main.py).
# Preview: every page is noindex and there is no HSTS (.dev is HSTS-preloaded).
# A launch build (VITE_SITE_INDEXABLE=true) rewrites this file in dist/: see
# pagesHeaders in src/site.ts. Keep the /* rule starting with X-Robots-Tag.
/*
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://consent.cookiebot.com https://consentcdn.cookiebot.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://consent.cookiebot.com https://consentcdn.cookiebot.com; connect-src 'self' https://*.supabase.co https://cloudflareinsights.com https://consent.cookiebot.com https://consentcdn.cookiebot.com; worker-src 'self' blob:; frame-src https://consentcdn.cookiebot.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The Graphify code graph is generated HTML with inline scripts, so it drops the
# app's CSP; X-Frame-Options still blocks framing.
/graph/*
  ! Content-Security-Policy

/assets/*
  Cache-Control: public, max-age=31536000, immutable
