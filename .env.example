# Public browser configuration only; never put backend credentials in VITE_*.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-public-key
# Launch only (#39): approved HTTPS site address and indexing switch. Leave unset on preview.
VITE_SITE_URL=
VITE_SITE_INDEXABLE=
# Optional Cloudflare Web Analytics site token (public); unset keeps analytics off.
VITE_CF_WEB_ANALYTICS_TOKEN=
# Preview builds read Actions Variables (or existing Secrets) named
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY into the corresponding VITE_* values.
# Configure those in GitHub directly, never use a service-role key in the build.
# Backend only; do not copy these into frontend environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-locally-never-commit
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# The API verifies tokens with the public keys at $SUPABASE_URL/auth/v1/.well-known/jwks.json.
# The project must use asymmetric JWT signing keys; the legacy HS256 secret is never used.
ALLOWED_ORIGINS=http://localhost:5173
# Saved practice (#10): Supabase Session pooler connection string, backend only.
# The API runs each transaction as service_role; without it saved-practice routes return 503.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=require
# Hosted migration delivery uses GitHub Actions secrets, configured by the human:
# SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD.
# No service-role key is needed by the migration workflow.
# GitHub variable SUPABASE_MIGRATIONS_READY=true enables apply after first dry-run.
# Human-run hosted test needs the public SUPABASE_PUBLISHABLE_KEY locally.
# Never persist user access tokens; scripts/test_supabase_hosted.py prompts privately.
